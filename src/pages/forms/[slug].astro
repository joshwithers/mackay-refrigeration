---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import MarkdownForm from "../../components/MarkdownForm.astro";
import { getEntry } from "astro:content";
import { actions } from "astro:actions";
import { hashSecret, runtimeEnv } from "../../server/db";

export const prerender = false;

const { slug } = Astro.params;
if (slug !== "service-supply" && slug !== "hire-contract") {
  return Astro.redirect("/404");
}
const definition = await getEntry("forms", slug);
if (!definition) return Astro.redirect("/404");

const token = Astro.url.searchParams.get("token") || "";
const actionResult = Astro.getActionResult(actions.forms.submit);
const actionData = actionResult?.data as
  | {
      success?: boolean;
      formType?: string;
      errors?: Record<string, string>;
      values?: Record<string, string | string[]>;
    }
  | undefined;
let inviteValid = actionData?.success === true && actionData.formType === slug;
let values: Record<string, string | string[]> = {};
if (token && !inviteValid) {
  try {
    const contact = await runtimeEnv()
      .DB.prepare(
        `SELECT c.name, c.email, c.phone, o.name AS company
       FROM form_invites i
       JOIN contacts c ON c.id = i.contact_id
       LEFT JOIN organisations o ON o.id = c.organisation_id
       WHERE i.form_slug = ? AND i.token_hash = ? AND i.completed_at IS NULL AND i.revoked_at IS NULL AND i.expires_at > ?`,
      )
      .bind(slug, await hashSecret(token), new Date().toISOString())
      .first<{
        name: string;
        email: string | null;
        phone: string | null;
        company: string | null;
      }>();
    if (contact) {
      inviteValid = true;
      values =
        slug === "hire-contract"
          ? {
              hirer_name: contact.name,
              hirer_email: contact.email || "",
              hirer_phone: contact.phone || "",
              hirer_company: contact.company || "",
            }
          : {
              full_name: contact.name,
              email: contact.email || "",
              phone: contact.phone || "",
              company: contact.company || "",
            };
    }
  } catch {
    // Invalid or unavailable bindings are handled by the submit action.
  }
}
const formValues =
  actionData?.formType === slug && actionData.values
    ? actionData.values
    : values;
---

<Base
  title={definition.data.title}
  description={definition.data.description}
  noindex
>
  <div class="legal-header form-route-header">
    <div class="hero-badge">
      <span class="pulse"></span> Mackay Refrigeration
    </div>
    <h1>{definition.data.title}</h1>
    <p class="legal-last-updated">{definition.data.description}</p>
  </div>

  <div class="form-page-shell">
    {
      inviteValid ? (
        <MarkdownForm
          definition={definition.data}
          formType={slug}
          inviteToken={token}
          values={formValues}
          errors={actionData?.formType === slug ? actionData.errors : undefined}
          success={actionData?.success === true && actionData.formType === slug}
        />
      ) : (
        <div class="form-confirmation" role="alert">
          <div class="hero-badge">
            <span class="pulse" /> Secure link required
          </div>
          <h2>This form link is unavailable</h2>
          <p>
            Ask Mackay Refrigeration to send you a new secure form link, or
            contact the team if you need help.
          </p>
          <a class="cta-btn" href="/contact">
            Contact Mackay Refrigeration <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
  <Footer />
</Base>
