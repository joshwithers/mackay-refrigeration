---
import Base from "../../layouts/Base.astro";
import CrmNav from "../../components/CrmNav.astro";
import { actions } from "astro:actions";
import { runtimeEnv } from "../../server/db";

export const prerender = false;

if (!Astro.locals.user) return Astro.redirect("/crm/login");
if (Astro.locals.user.role !== "admin") return Astro.redirect("/crm");

const current = runtimeEnv();
const rules = await current.DB.prepare(
  `SELECT id, event_type, recipient_email, updated_at
   FROM notification_rules WHERE active = 1 ORDER BY event_type, recipient_email`,
).all<{
  id: string;
  event_type: string;
  recipient_email: string;
  updated_at: string;
}>();
const fallbackEmail =
  current.STAFF_NOTIFICATION_EMAIL || "service@mackayrefrig.com.au";
const notificationGroups = [
  {
    eventType: "enquiry_created",
    title: "New enquiry",
    description: "Website contact forms and enquiries recorded by phone.",
  },
  {
    eventType: "form_submitted",
    title: "Completed customer form",
    description: "Completed service supply forms and hire contracts.",
  },
].map((group) => ({
  ...group,
  rules: rules.results.filter((rule) => rule.event_type === group.eventType),
}));
const saveResult = Astro.getActionResult(actions.staff.saveNotificationRule);
const removeResult = Astro.getActionResult(
  actions.staff.removeNotificationRule,
);
---

<Base
  title="CRM settings"
  description="Mackay Refrigeration CRM notification settings."
  noindex
>
  <div class="crm-shell">
    <div class="crm-breadcrumb"><a href="/crm">CRM</a> / Settings</div>
    <header class="crm-header">
      <div>
        <div class="hero-badge"><span class="pulse"></span> CRM settings</div>
        <h1>Notification <span class="cold">settings</span></h1>
        <p class="crm-muted">
          Choose which staff inboxes receive new enquiries and completed
          customer forms.
        </p>
      </div>
      <div class="crm-header-actions">
        <a class="crm-secondary-btn" href="/crm">Back to dashboard</a>
      </div>
    </header>

    <CrmNav active="settings" role={Astro.locals.user.role} />

    <section class="crm-settings-grid">
      <div class="crm-panel">
        <div class="crm-panel-heading">
          <div>
            <div class="crm-kicker">Add a rule</div><h2>Route an alert</h2>
          </div>
        </div>
        <div class="crm-settings-explainer">
          <strong>How notification rules work</strong>
          <p>
            One rule connects one alert type to one staff inbox. Add the same
            address to both alert types if it should receive every notification.
            If an alert type has no rules, it goes to the fallback inbox shown
            under Current delivery.
          </p>
        </div>
        <form
          method="POST"
          action={actions.staff.saveNotificationRule}
          class="crm-form"
        >
          <label class="form-label" for="rule-event">Notification type</label>
          <select class="form-select" id="rule-event" name="eventType">
            <option value="form_submitted">Completed customer form</option>
            <option value="enquiry_created"
              >New enquiry (website or phone)</option
            >
          </select>
          <label class="form-label" for="rule-email">Staff email address</label>
          <input
            class="form-input"
            type="email"
            id="rule-email"
            name="recipientEmail"
            required
            autocomplete="email"
            placeholder="staff@example.com"
          />
          <button class="cta-btn" type="submit"
            >Add notification rule <span aria-hidden="true">→</span></button
          >
        </form>
        {
          saveResult?.data?.success && (
            <p class="crm-success" role="status">
              Notification recipient saved.
            </p>
          )
        }
        {
          saveResult?.error && (
            <p class="crm-error" role="alert">
              Could not save that recipient. Check the address and try again.
            </p>
          )
        }
        {
          removeResult?.data?.success && (
            <p class="crm-success" role="status">
              Notification recipient removed.
            </p>
          )
        }
      </div>

      <div class="crm-panel">
        <div class="crm-panel-heading">
          <div>
            <div class="crm-kicker">Current delivery</div><h2>
              Who receives what
            </h2>
          </div>
        </div>
        <p class="crm-panel-intro">
          These are the effective recipients right now. Removing a rule affects
          only that alert type and inbox.
        </p>
        {
          (
            <div class="crm-rule-groups">
              {notificationGroups.map((group) => (
                <section class="crm-rule-group">
                  <div class="crm-rule-group-heading">
                    <span class="crm-rule-trigger">When</span>
                    <div>
                      <h3>{group.title}</h3>
                      <p>{group.description}</p>
                    </div>
                  </div>
                  <div class="crm-rule-recipients">
                    {group.rules.length ? (
                      group.rules.map((rule) => (
                        <div class="crm-rule-recipient">
                          <div>
                            <span class="crm-rule-label">Send to</span>
                            <strong>{rule.recipient_email}</strong>
                          </div>
                          <form
                            method="POST"
                            action={actions.staff.removeNotificationRule}
                          >
                            <input type="hidden" name="id" value={rule.id} />
                            <button class="crm-small-button" type="submit">
                              Remove rule
                            </button>
                          </form>
                        </div>
                      ))
                    ) : (
                      <div class="crm-rule-recipient crm-rule-fallback">
                        <div>
                          <span class="crm-rule-label">Fallback inbox</span>
                          <strong>{fallbackEmail}</strong>
                        </div>
                        <span class="crm-rule-status">No custom rules</span>
                      </div>
                    )}
                  </div>
                </section>
              ))}
              <div class="crm-rule-note">
                Adding the first custom rule for an alert type replaces its
                fallback delivery. Add another rule to send that alert to more
                than one inbox.
              </div>
            </div>
          )
        }
      </div>
    </section>
  </div>
</Base>
